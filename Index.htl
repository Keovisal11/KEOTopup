<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KEO Top Up</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
      text-align: center;
    }

    header {
      padding: 25px;
      background: #111827;
    }

    h1 {
      margin: 0;
    }

    .container {
      padding: 30px 15px;
    }

    .game {
      background: #1e293b;
      margin: 15px auto;
      padding: 25px;
      border-radius: 15px;
      max-width: 350px;
    }

    button {
      background: #22c55e;
      color: white;
      border: none;
      padding: 12px 25px;
      border-radius: 10px;
      font-size: 16px;
    }

    button:hover {
      background: #16a34a;
    }
  </style>
</head>

<body>

  <header>
    <h1>🎮 KEO TOP UP</h1>
    <p>Fast & Easy Game Top Up</p>
  </header>

  <div class="container">

    <h2>Choose Your Game</h2>

    <div class="game">
      <h2>🔥 Free Fire</h2>
      <p>Diamonds Top Up</p>
      <button>Top Up Now</button>
    </div>

    <div class="game">
      <h2>⚔️ Mobile Legends</h2>
      <p>Diamonds Top Up</p>
      <button>Top Up Now</button>
    </div>

  </div>

</body>
</html>
